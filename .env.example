# Twitter Monitor — Environment
# Copy to .env and fill in real values.

# Shared Twitter scraper service (webscraper)
TWITTER_SCRAPER_BASE_URL=http://ser:18023

# Immich — replace with the real values (dummy placeholders for now)
IMMICH_BASE_URL=http://immich:2283
IMMICH_API_KEY=REPLACE_WITH_IMMICH_API_KEY

# Monitor schedule (cron) and caps
MONITOR_CRON=*/30 * * * *
TWITTER_MAX_PER_ACCOUNT=10
TWITTER_IMAGE_FETCH_TIMEOUT=30

# Runtime paths (inside container)
DB_PATH=/app/data/twitter-monitor.db
ARCHIVE_DIR=/app/data/archive

# Timezone
TZ=Europe/Amsterdam